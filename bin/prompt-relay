#!/usr/bin/env python3
"""Entry point that runs from a repository checkout without installation."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

if sys.argv[1:] == ["hook"]:
    # Fast path for Claude Code: skip argparse and the export modules.
    from prompt_relay.hook import main as hook_main

    sys.exit(hook_main())

from prompt_relay.cli import main  # noqa: E402

sys.exit(main())
